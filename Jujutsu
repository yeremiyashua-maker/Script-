local espActive = false
local function applyESP(player)
    if player == LocalPlayer then return end
    
    local function addESPToChar(char)
        if not espActive then return end
        
        -- Highlight
        if not char:FindFirstChild("BlueHighlightESP") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "BlueHighlightESP"
            highlight.FillColor = Color3.fromRGB(0, 140, 255)
            highlight.OutlineColor = Color3.fromRGB(0, 230, 255)
            highlight.FillTransparency = 0.4
            highlight.Parent = char
        end

        -- Línea Tracer (Beam)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and myHrp then
            if char:FindFirstChild("EspTracerBeam") then char.EspTracerBeam:Destroy() end
            
            local att0 = Instance.new("Attachment", myHrp)
            att0.Name = "EspAtt0"
            local att1 = Instance.new("Attachment", hrp)
            att1.Name = "EspAtt1"

            local beam = Instance.new("Beam")
            beam.Name = "EspTracerBeam"
            beam.Attachment0 = att0
            beam.Attachment1 = att1
            beam.Color = ColorSequence.new(Color3.fromRGB(0, 170, 255))
            beam.Width0 = 0.1
            beam.Width1 = 0.1
            beam.AlwaysOnTop = true
            beam.Parent = char
        end
    end

    player.CharacterAdded:Connect(addESPToChar)
    if player.Character then addESPToChar(player.Character) end
end

EspBtn.MouseButton1Click:Connect(function()
    espActive = not espActive
    if espActive then
        EspBtn.Text = "ESP Jugadores (Líneas): ON"
        EspBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 255)
        for _, p in pairs(Players:GetPlayers()) do applyESP(p) end
    else
        EspBtn.Text = "ESP Jugadores (Líneas): OFF"
        EspBtn.BackgroundColor3 = Color3.fromRGB(20, 35, 60)
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character then
                if p.Character:FindFirstChild("BlueHighlightESP") then p.Character.BlueHighlightESP:Destroy() end
                if p.Character:FindFirstChild("EspTracerBeam") then p.Character.EspTracerBeam:Destroy() end
            end
        end
    end
end)

