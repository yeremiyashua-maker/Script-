            task.delay(1.5, function()
                pcall(function()
                    TweenService:Create(FloatingNotif, TweenInfo.new(0.3), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
                    TweenService:Create(NotifStroke, TweenInfo.new(0.3), {Transparency = 1}):Play()
                    task.wait(0.3)
                    FloatingNotif.Visible = false
                end)
            end)
        end)
    end

