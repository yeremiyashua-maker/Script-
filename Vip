                    local char = player.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                    if root and humanoid then
                        -- Aparece primero en el checkpoint de la imagen morada
                        root.CFrame = CFrame.new(posPurpleTreadmill)
                        task.wait(0.2)
                        if not isActiveRef() then break end

                        TreadmillStatusInfo.Text = "Estado: Teleguiando a " .. treadmillName .. "..."
                        
                        local customSpeed = tonumber(SpeedBox.Text) or 50
                        local distance = (posPurpleTreadmill - targetCoord).Magnitude
                        local travelTime = math.clamp(distance / customSpeed, 0.2, 5)
                        local elapsed = 0

                        while isActiveRef() and char and char.Parent and elapsed < travelTime do
                            local dt = RunService.RenderStepped:Wait()
                            elapsed = elapsed + dt
                            local alpha = math.clamp(elapsed / travelTime, 0, 1)
                            if humanoid.Health <= 0 then break end
                            root.CFrame = CFrame.new(posPurpleTreadmill:Lerp(targetCoord, alpha))
                            drawTreadmillBeam(root.Position, targetCoord)
                        end

                        if not isActiveRef() then break end
                        root.CFrame = CFrame.new(targetCoord)
                        clearTreadmillBeam()

                        -- Se queda fijo en la caminadora tocándola permanentemente
                        TreadmillStatusInfo.Text = "Estado: Tocando " .. treadmillName .. " [Fijo]"
                        while isActiveRef() and char and char.Parent and humanoid.Health > 0 do
                            root.CFrame = CFrame.new(targetCoord)
                            pcall(function()
                                for _, obj in pairs(Workspace:GetDescendants()) do
                                    if obj and obj.Parent and (obj:IsA("TouchTransmitter") or obj.ClassName == "TouchTransmitter") then
                                        local part = obj.Parent
                                        if part:IsA("BasePart") and (part.Position - targetCoord).Magnitude < 15 then
                                            firetouchinterest(root, part, 0)
                                            firetouchinterest(root, part, 1)
                                        end
                                    end
                                end
                            end)
                            task.wait(0.2)
                        end
                    else
                        task.wait(1)
                    end
                else
                    clearTreadmillBeam()
                    task.wait(0.4)
                end
            end
        end)
    end

    runTreadmillTeleguiado(function() return treadmillBasicActive end, posTreadmillA, "Basic (A)")
    runTreadmillTeleguiado(function() return treadmillGoldActive end, posTreadmillB, "Gold (B)")
    runTreadmillTeleguiado(function() return treadmillGalaxyActive end, posTreadmillC, "Galaxy (C)")
