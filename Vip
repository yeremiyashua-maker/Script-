    local function formatNumber(v)
        if not v or type(v) ~= "number" then return "0" end
        if v >= 1e18 then
            return string.format("%.2f Tril", v / 1e18)
        elseif v >= 1e12 then
            return string.format("%.2f Bill", v / 1e12)
        elseif v >= 1e6 then
            return string.format("%.2f Mill", v / 1e6)
        elseif v >= 1e3 then
            return string.format("%.2f k", v / 1e3)
        else
            return tostring(math.floor(v))
        end
    end

    task.spawn(function()
        local startTime = tick()
        local initialCups = nil
        local initialSpeed = nil
        local lastCheckedCups = nil
        local lastCheckedSpeed = nil
        local realTimeCupsGained = 0
        local realTimeSpeedGained = 0

        while VisualsContainer and VisualsContainer.Parent do
            task.wait(0.5)
            local elapsedSec = math.floor(tick() - startTime)
            local h = math.floor(elapsedSec / 3600)
            local m = math.floor((elapsedSec % 3600) / 60)
            local s = elapsedSec % 60
            TimePlayedLbl.Text = string.format("⏱️ Tiempo Jugado: %02d:%02d:%02d", h, m, s)

            pcall(function()
                local leaderstats = player:FindFirstChild("leaderstats")
                if leaderstats then
                    for _, stat in pairs(leaderstats:GetChildren()) do
                        local nameLower = string.lower(stat.Name)
                        if string.find(nameLower, "copa") or string.find(nameLower, "win") then
                            if initialCups == nil then
                                initialCups = stat.Value
                                lastCheckedCups = stat.Value
                            else
                                local diff = stat.Value - lastCheckedCups
                                if diff > 0 then
                                    realTimeCupsGained = realTimeCupsGained + diff
                                end
                                lastCheckedCups = stat.Value
                            end
                            CupsWonLbl.Text = "🏆 Copas Ganadas: " .. formatNumber(realTimeCupsGained) .. " (" .. formatNumber(stat.Value) .. " total)"
                        end
                        if string.find(nameLower, "speed") or string.find(nameLower, "velo") then
                            if initialSpeed == nil then
                                initialSpeed = stat.Value
                                lastCheckedSpeed = stat.Value
                            else
                                local diffSpd = stat.Value - lastCheckedSpeed
                                if diffSpd > 0 then
                                    realTimeSpeedGained = realTimeSpeedGained + diffSpd
                                end
                                lastCheckedSpeed = stat.Value
                            end
                            SpeedGainedLbl.Text = "⚡ Velocidad Ganada: " .. formatNumber(realTimeSpeedGained)
                        end
                    end
                end
            end)
        end
    end)

