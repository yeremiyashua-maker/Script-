-- Bucle World 1
task.spawn(function()
    while true do
        if world1Active then
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            
            if root and humanoid then
                root.CFrame = CFrame.new(posA1)
                task.wait(0.2)
                if not world1Active then break end

                root.CFrame = CFrame.new(posB1)
                task.wait(0.2)
                if not world1Active then break end

                local travelTime = 3.5
                local elapsed = 0
                StatusInfo.Text = "Estado: W1 - Recorriendo camino..."
                while world1Active and char and char.Parent and elapsed < travelTime do
                    local dt = RunService.RenderStepped:Wait()
                    elapsed = elapsed + dt
                    local alpha = math.clamp(elapsed / travelTime, 0, 1)
                    if humanoid.Health <= 0 then break end
                    root.CFrame = CFrame.new(posB1:Lerp(posC1, alpha))
                    drawNeonLine(root.Position, posC1)
                end

                root.CFrame = CFrame.new(posC1)
                clearNeonLine()
                
                local collected = false
                pcall(function()
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj and obj.Parent and (obj:IsA("TouchTransmitter") or obj.ClassName == "TouchTransmitter") then
                            local part = obj.Parent
                            if part:IsA("BasePart") and (part.Position - posC1).Magnitude < 25 then
                                firetouchinterest(root, part, 0)
                                firetouchinterest(root, part, 1)
                                collected = true
                            end
                        end
                    end
                end)

                if collected then
                    showFloatingMessage("¡Se agarraron exitosamente (W1)! 💜")
                else
                    showFloatingMessage("¡W1 alcanzado! Verificando...")
                end

                StatusInfo.Text = "Estado: ¡Wins detectadas y recogidas (W1)! 💜"
                task.wait(1.0)
            else
                task.wait(1)
            end
        else
            task.wait(0.4)
        end
    end
end)

