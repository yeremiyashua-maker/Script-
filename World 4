------------------------------------------------------------------
-- RUTA Y LÓGICA DE MOVIMIENTO (CAMINATA MEDIO LENTA Y SUAVE)
------------------------------------------------------------------
local posA = Vector3.new(-438.7, 27.3, 5776.5) -- Inicio
local posB = Vector3.new(-7758.6, 18.6, 5778.8) -- Teletransporte intermedio
local posC = Vector3.new(-7759.8, 22.1, 5742.2) -- Destino final con animación lenta

local beamFolder = Instance.new("Folder", Workspace)
beamFolder.Name = "OmegaBeamFolder"

local function drawNeonLine(startPos, endPos)
    pcall(function()
        for _, v in pairs(beamFolder:GetChildren()) do v:Destroy() end
        local part = Instance.new("Part")
        part.Size = Vector3.new(0.35, 0.35, (startPos - endPos).Magnitude)
        part.CFrame = CFrame.new(startPos, endPos) * CFrame.new(0, 0, -(startPos - endPos).Magnitude / 2)
        part.Anchored = true
        part.CanCollide = false
        part.Material = Enum.Material.Neon
        part.Color = Color3.fromRGB(255, 100, 215) -- Línea rosa brillante
        part.Parent = beamFolder
    end)
end

local function clearNeonLine()
    pcall(function() for _, v in pairs(beamFolder:GetChildren()) do v:Destroy() end end)
end

