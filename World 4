local function runWorldRoutine(posA, posB, posC, worldName)
    while true do
        local checkActive = (worldName == "W1" and world1Active) or (worldName == "W2" and world2Active) or (worldName == "W3" and world3Active) or (worldName == "W4" and world4Active)
        if checkActive then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            
            if root and humanoid then
                root.CFrame = CFrame.new(posA)
                task.wait(0.2)
                if not ((worldName == "W1" and world1Active) or (worldName == "W2" and world2Active) or (worldName == "W3" and world3Active) or (worldName == "W4" and world4Active)) then break end

                root.CFrame = CFrame.new(posB)
                task.wait(0.2)
                if not ((worldName == "W1" and world1Active) or (worldName == "W2" and world2Active) or (worldName == "W3" and world3Active) or (worldName == "W4" and world4Active)) then break end

                local travelTime = 3.5
                local elapsed = 0
                StatusInfo.Text = "Status: " .. worldName .. " - Pathfinding..."
                while ((worldName == "W1" and world1Active) or (worldName == "W2" and world2Active) or (worldName == "W3" and world3Active) or (worldName == "W4" and world4Active)) and char and char.Parent and elapsed < travelTime do
                    local dt = RunService.RenderStepped:Wait()
                    elapsed = elapsed + dt
                    local alpha = math.clamp(elapsed / travelTime, 0, 1)
                    if humanoid.Health <= 0 then break end
                    root.CFrame = CFrame.new(posB:Lerp(posC, alpha))
                    drawNeonLine(root.Position, posC)
                end

                root.CFrame = CFrame.new(posC)
                clearNeonLine()
                
                pcall(function()
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj and obj.Parent and (obj:IsA("TouchTransmitter") or obj.ClassName == "TouchTransmitter") then
                            local part = obj.Parent
                            if part:IsA("BasePart") and (part.Position - posC).Magnitude < 25 then
                                firetouchinterest(root, part, 0)
                                firetouchinterest(root, part, 1)
                            end
                        end
                    end
                end)

                StatusInfo.Text = "Status: Wins collected (" .. worldName .. ")"
                task.wait(1.0)
            else
                task.wait(1)
            end
        else
            task.wait(0.4)
        end
    end
end

