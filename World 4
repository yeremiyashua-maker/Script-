    end
end)

-- Bucle principal: A -> Teletransporte a B -> Animación medio lenta hacia C
task.spawn(function()
    while true do
        if world4Active then
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            
            if root and humanoid then
                -- 1. Teletransporte a A
                root.CFrame = CFrame.new(posA)
                task.wait(0.4)

                if not world4Active then break end

                -- 2. Teletransporte a B
                root.CFrame = CFrame.new(posB)
                task.wait(0.4)

                if not world4Active then break end

                -- 3. Animación de caminata / recorrido MEDIO LENTO y suave hacia C
                local travelTime = 3.5 -- Velocidad media lenta y fluida para que se aprecie bien
                local elapsed = 0

                StatusInfo.Text = "Estado: Recorriendo camino hacia C..."
                while world4Active and char and char.Parent and elapsed < travelTime do
                    local dt = RunService.RenderStepped:Wait()
                    elapsed = elapsed + dt
                    local alpha = math.clamp(elapsed / travelTime, 0, 1)
                    
                    if humanoid.Health <= 0 then break end
                    
                    root.CFrame = CFrame.new(posB:Lerp(posC, alpha))
                    drawNeonLine(root.Position, posC)
                end

                root.CFrame = CFrame.new(posC)
                clearNeonLine()
                
                StatusInfo.Text = "Estado: ¡Ruta completada con éxito! 💜"
                task.wait(1.0)
            else
                task.wait(1)
            end
        else
            clearNeonLine()
            task.wait(0.4)
        end
    end
end)

