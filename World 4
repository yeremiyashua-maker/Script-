local mfDrag, mfOX, mfOY, mfStartPos = false, 0, 0, Vector2.zero
MainFrame.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.Touch
    or inp.UserInputType == Enum.UserInputType.MouseButton1 then
        mfStartPos = Vector2.new(inp.Position.X, inp.Position.Y)
        mfOX       = inp.Position.X - MainFrame.AbsolutePosition.X
        mfOY       = inp.Position.Y - MainFrame.AbsolutePosition.Y
    end
end)
MainFrame.InputChanged:Connect(function(inp)
    if (inp.UserInputType == Enum.UserInputType.Touch
    or inp.UserInputType == Enum.UserInputType.MouseMovement) and mfStartPos ~= Vector2.zero then
        local currentPos = Vector2.new(inp.Position.X, inp.Position.Y)
        if (currentPos - mfStartPos).Magnitude > 12 then
            mfDrag = true
        end
        if mfDrag then
            MainFrame.Position = UDim2.new(0, inp.Position.X - mfOX, 0, inp.Position.Y - mfOY)
        end
    end
end)
MainFrame.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.Touch
    or inp.UserInputType == Enum.UserInputType.MouseButton1 then
        mfDrag     = false
        mfStartPos = Vector2.zero
    end
end)

